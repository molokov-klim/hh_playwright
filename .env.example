# Пример файла конфигурации .env
# Скопируйте этот файл в .env и укажите свои значения

# Данные для входа на hh.ru (обязательные)
HH_LOGIN=ваш_email_или_телефон
HH_PASSWORD=ваш_пароль

# Режим работы (необязательные)
FAKE=false  # Установите в true, чтобы запустить в режиме без реальных откликов
HEADLESS=true  # Режим без GUI (true/false)

# Настройки браузера (необязательные)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
TIMEOUT=30000

# ID резюме (опционально, будет определен автоматически)
RESUME_ID=

# Настройки Telegram-бота (необязательные)
TELEGRAM_BOT_TOKEN=6209761567:AAG3QwLjuGqAoFVww4PqvmEcB-O-8qiXZFk
TELEGRAM_CHAT_ID=1353223764